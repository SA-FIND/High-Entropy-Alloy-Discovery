# Byte-compiled / optimized / C extensions
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
build/
dist/
*.egg-info/

# Unit-test / coverage reports
.pytest_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/
pymatgenenv/
*.env/

# Environment variables
.env
.env.*

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# IDE and OS files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
ehthumbs.db

# Frontend & Node dependencies
node_modules/

# Local development outputs & caches
*.log
*.tmp
*.bak
local/
scratch/
temp/
project_files/
# Downloaded external data (fetched by scripts)
data/external/**/*.csv

# Retired material, kept locally only
archive/

# Research proposals: shared privately on request (see README, "Research proposal")
RESEARCH_PROPOSAL*
*[Rr]esearch_[Pp]roposal*
proposal/

# Output of run_master.py (proxy-model scores, not results)
run_master_log.txt
run_master_err.txt

# Empty stderr captures from long runs
results/*_err.txt

# Manuscript: kept local until publication
paper/manuscript*.md
